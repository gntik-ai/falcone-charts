const MAX_OUTPUT = 16 * 1024
const COMMAND_TIMEOUT_MS = 10 * 60 * 1000
const REPO_ROOT = [resolve(__dirname, '..'), resolve(__dirname, '../..'), process.cwd()]
  .find((candidate) => existsSync(resolve(candidate, 'charts/falcone-knative')))
  ?? resolve(__dirname, '..')
const DEFAULT_CHART = resolve(REPO_ROOT, 'charts/falcone-knative')
const SMOKE_SOURCE = 'docker.io/library/busybox@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0'
const SMOKE_MIRROR_REPOSITORY = 'library/busybox'
const SMOKE_DIGEST = 'sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0'
const MANAGED_SELECTOR = 'app.kubernetes.io/part-of=falcone-knative'
const ADMISSION_CONFIGURATIONS = [
  ['validatingwebhookconfiguration', 'config.webhook.serving.knative.dev'],
  ['mutatingwebhookconfiguration', 'webhook.serving.knative.dev'],
  ['validatingwebhookconfiguration', 'validation.webhook.serving.knative.dev'],
]

const SECRET_WORDS = /(?:^|[^a-z])(token|kubeconfig|credential|pull\s+secret|tenant\s+name)(?:[^a-z]|$)/i
const SAFE_NAME = /^[a-zA-Z0-9](?:[a-zA-Z0-9._-]{0,126}[a-zA-Z0-9])?$/
const SAFE_KUBE_NAME = /^[a-z0-9](?:[-a-z0-9.]{0,251}[a-z0-9])?$/
const SAFE_ID = /^[a-zA-Z0-9](?:[a-zA-Z0-9._:@/-]{0,254}[a-zA-Z0-9])?$/
const SHA256 = /^[a-f0-9]{64}$/

const TOP_HELP = `${CLI_NAME} ${CLI_VERSION}

Versioned, client-side lifecycle for Falcone-managed Knative Serving + Kourier.

Usage:
  falcone-knative <command> [options]

Commands:
  preflight   Read-only compatibility, authority, inventory, and ownership checks
  install     Install managed Knative in readiness-gated stages
  upgrade     Upgrade by at most one Knative minor with a recovery record
  rollback    Roll back only when stored CRD versions remain compatible
  uninstall   Remove safe Falcone-owned components while retaining durable state
  purge       Separately-confirmed destructive removal of retained state
  handoff     Quiesce and transfer exclusive ownership to or from an Operator
  acceptance  Disposable-target outage, restart, recover, or replacement hook

Global options:
  -h, --help       Show help
  -V, --version    Show version
  --output json    Emit bounded, secret-safe JSON evidence (default: json)

Run "falcone-knative <command> --help" for command-specific options.
`

