#!/usr/bin/env sh
set -eu

printf '%s\n' "$*" >>"${FALCONE_STAGING_HELM_LOG:?}"
[ -z "${FALCONE_STAGING_OPERATION_LOG:-}" ] || printf 'helm %s\n' "$*" >>"$FALCONE_STAGING_OPERATION_LOG"
scenario="${FALCONE_STAGING_SCENARIO:-safe}"
helm_state="${FALCONE_STAGING_HELM_STATE_FILE:-${FALCONE_STAGING_STATE_FILE:?}.helm}"
upgrade_count=0
[ ! -f "$helm_state" ] || upgrade_count="$(cat "$helm_state")"
real_helm="${FALCONE_STAGING_HELM_DELEGATE:-${FALCONE_STAGING_REAL_HELM:-}}"
repair_version="${FALCONE_STAGING_REPAIR_VERSION:-0.4.12}"
repair_chart="in-falcone-${repair_version}"

legacy_values='{"global":{"webhookSigningKey":{"create":false,"secretName":"falcone-webhook-signing-key-c25-legacy","secretKey":"key","adoption":{"mode":"legacy","requestId":"c25-staging-adopt-20260723-01"},"rotation":{"action":"none","requestId":"","sourceSecretName":"","sourceSecretKey":"","rotationId":"","recoveryWindowSeconds":604800}}},"documentdb":{"persistence":{"storageClass":"local-path","size":"10Gi"}},"kafka":{"persistence":{"storageClass":"local-path","size":"10Gi"}},"observability":{"persistence":{"storageClass":"local-path","size":"10Gi"}},"postgresql":{"persistence":{"storageClass":"local-path","size":"10Gi"}},"seaweedfs":{"filer":{"data":{"storageClass":"hcloud-volumes","size":"10Gi"}},"master":{"data":{"storageClass":"hcloud-volumes","size":"10Gi"}}}}'
failed_hook_description='Upgrade "falcone" failed: pre-upgrade hooks failed: job falcone-in-falcone-webhook-key-credential failed: CREDENTIAL_MANAGED_SECRET_MISSING'
r22_immutable_description='Upgrade "falcone" failed: cannot patch "falcone-documentdb-data" with kind PersistentVolumeClaim: PersistentVolumeClaim "falcone-documentdb-data" is invalid: spec.storageClassName: Forbidden: field is immutable (local-path -> null); cannot patch "falcone-kafka-data" with kind PersistentVolumeClaim: PersistentVolumeClaim "falcone-kafka-data" is invalid: spec.storageClassName: Forbidden: field is immutable (local-path -> null); cannot patch "falcone-observability-data" with kind PersistentVolumeClaim: PersistentVolumeClaim "falcone-observability-data" is invalid: spec.storageClassName: Forbidden: field is immutable (local-path -> null); cannot patch "falcone-postgresql-data" with kind PersistentVolumeClaim: PersistentVolumeClaim "falcone-postgresql-data" is invalid: spec.storageClassName: Forbidden: field is immutable (local-path -> null); cannot patch "falcone-seaweedfs-filer" with kind StatefulSet: StatefulSet.apps "falcone-seaweedfs-filer" is invalid: spec: Forbidden: immutable StatefulSet fields changed; cannot patch "falcone-seaweedfs-master" with kind StatefulSet: StatefulSet.apps "falcone-seaweedfs-master" is invalid: spec: Forbidden: immutable StatefulSet fields changed'

require_repair_version() {
  case " $* " in
    *" --version $repair_version "*) ;;
    *)
      printf 'REPAIR_CHART_VERSION_MISMATCH expected=%s call=%s\n' "$repair_version" "$*" >&2
      exit 64
      ;;
  esac
}

release_revision=20
release_chart="in-falcone-0.4.1"
release_status="deployed"
case "$scenario" in
  r23-nonnumeric-*)
    release_revision=23
    release_chart="in-falcone-0.4.9"
    release_status="failed"
    ;;
  phase-a-complete|phase-a-attestation-*|forward-*)
    release_revision=25
    release_chart="$repair_chart"
    ;;
  r22-immutable-*)
    release_revision=22
    release_chart="in-falcone-0.4.8"
    release_status="failed"
    ;;
  wrong-start-chart)
    release_chart="in-falcone-0.4.2"
    ;;
  failed-resume-*)
    release_revision=21
    release_chart="in-falcone-0.4.7"
    release_status="failed"
    ;;
esac
case "${FALCONE_STAGING_EXTERNAL_OWNER_BASE_SCENARIO:-}" in
  forward-*)
    release_revision=25
    release_chart="$repair_chart"
    ;;
esac
case "$scenario" in
  failed-resume-list-status-drift) release_status="pending-upgrade" ;;
  failed-resume-list-revision-drift) release_revision=22 ;;
  failed-resume-list-chart-drift) release_chart="in-falcone-0.4.6" ;;
  r22-immutable-status-drift) release_status="pending-upgrade" ;;
  r22-immutable-chart-drift) release_chart="in-falcone-0.4.7" ;;
esac
if [ "$upgrade_count" -gt 0 ]; then
  release_revision=$((release_revision + upgrade_count))
  release_chart="$repair_chart"
  release_status="deployed"
fi

case "${1:-}" in
  list)
    printf '[{"name":"falcone","namespace":"in-falcone-staging","revision":"%s","chart":"%s","app_version":"0.3.1","status":"deployed"}]\n' \
      "$release_revision" "$release_chart" | sed "s/\"status\":\"deployed\"/\"status\":\"$release_status\"/"
    ;;
  pull)
    require_repair_version "$@"
    untar_dir=""
    requested_version=""
    previous=""
    for argument in "$@"; do
      case "$previous" in
        --untardir) untar_dir="$argument" ;;
        --version) requested_version="$argument" ;;
      esac
      previous="$argument"
    done
    [ -n "$untar_dir" ] || { printf 'missing --untardir in synthetic pull\n' >&2; exit 65; }
    [ -n "$requested_version" ] || { printf 'missing --version in synthetic pull\n' >&2; exit 65; }
    [ -n "$real_helm" ] || { printf 'missing real Helm delegate\n' >&2; exit 65; }
    package_version="${FALCONE_STAGING_PACKAGED_TOP_LEVEL_VERSION:-$requested_version}"
    "$real_helm" package "${FALCONE_STAGING_PACKAGED_CHART_SOURCE:?}" \
      --destination "$untar_dir" --version "$package_version" >/dev/null
    tar -xzf "$untar_dir/in-falcone-$package_version.tgz" -C "$untar_dir"
    packaged_chart="$untar_dir/in-falcone/Chart.yaml"
    first_version="$(awk '$1 == "version:" { print $2; exit }' "$packaged_chart")"
    top_level_version="$(awk '$0 ~ /^version:[[:space:]]/ { print $2; exit }' "$packaged_chart")"
    printf 'fixture-package first-version=%s top-level-version=%s\n' \
      "$first_version" "$top_level_version" >>"${FALCONE_STAGING_HELM_LOG:?}"
    printf 'Pulled: ghcr.io/gntik-ai/charts/in-falcone:%s\n' "$requested_version"
    printf 'Digest: %s\n' "${FALCONE_STAGING_REPAIR_PACKAGE_DIGEST:?}"
    ;;
  template)
    require_repair_version "$@"
    [ -n "$real_helm" ] || { printf 'missing real Helm delegate\n' >&2; exit 65; }
    "$real_helm" "$@"
    if [ "${FALCONE_STAGING_ASSUME_APPROVED_RENDER:-false}" = "true" ]; then
      # Downstream gate tests model a render that has already passed the image
      # authority preflight. The unmodified render is used by the dry-run test.
      printf '# bbx dependency image=ghcr.io/gntik-ai/in-falcone-mcp-runtime@sha256:f0bb4c639f08c40c650e3f2b45a0d3c546fa84b0ae5d2eb9a4153860ec06a162\n'
    fi
    ;;
  plugin)
    if [ "${2:-}" = "list" ]; then
      printf 'NAME VERSION DESCRIPTION\n'
      printf 'diff 3.9.12 Preview Helm upgrade changes as a diff\n'
      exit 0
    fi
    exit 2
    ;;
  diff)
    [ "${2:-}" = "upgrade" ] || exit 2
    require_repair_version "$@"
    case "$scenario" in
      external-owner-cluster-create)
        printf ', external-secrets-controller, ClusterRole (rbac.authorization.k8s.io) has been added:\n'
        ;;
      external-owner-namespaced-update)
        printf 'external-secrets, external-secrets, Deployment (apps) has changed:\n'
        ;;
      external-owner-cluster-remove)
        printf 'in-falcone, externalsecret-validate, ValidatingWebhookConfiguration (admissionregistration.k8s.io) has been removed:\n'
        ;;
      falcone-integration-and-legacy-sa-migration)
        printf ', openbao-backend, ClusterSecretStore (external-secrets.io) has changed:\n'
        jq -r '.falconeIntegrationResources[] | select(.kind == "ExternalSecret") | .name' \
          "${FALCONE_STAGING_REVISION20_MANIFEST:?}" | while IFS= read -r resource_name; do
          printf 'in-falcone-staging, %s, ExternalSecret (external-secrets.io) has changed:\n' "$resource_name"
        done
        printf 'external-secrets, eso-openbao-auth, ServiceAccount (v1) has been removed:\n'
        ;;
      external-owner-exact-resource)
        api_version="${FALCONE_STAGING_EXTERNAL_OWNER_API_VERSION:?}"
        api_group="${api_version%/*}"
        [ "$api_group" != "$api_version" ] || api_group="$api_version"
        printf '%s, %s, %s (%s) has changed:\n' \
          "${FALCONE_STAGING_EXTERNAL_OWNER_NAMESPACE-}" \
          "${FALCONE_STAGING_EXTERNAL_OWNER_NAME:?}" \
          "${FALCONE_STAGING_EXTERNAL_OWNER_KIND:?}" \
          "$api_group"
        ;;
    esac
    exit 0
    ;;
  get)
    case "${2:-}" in
      values)
        case "$scenario" in
          custody-values-missing) printf '{}\n' ;;
          custody-values-create-drift) printf '%s\n' "$legacy_values" | jq '.global.webhookSigningKey.create = true' ;;
          custody-values-name-drift) printf '%s\n' "$legacy_values" | jq '.global.webhookSigningKey.secretName = "another-reference"' ;;
          custody-values-adoption-drift) printf '%s\n' "$legacy_values" | jq '.global.webhookSigningKey.adoption.mode = "none"' ;;
          custody-values-rotation-drift) printf '%s\n' "$legacy_values" | jq '.global.webhookSigningKey.rotation.requestId = "unexpected-request"' ;;
          *) printf '%s\n' "$legacy_values" ;;
        esac
        ;;
      manifest)
        printf 'SECRET_BEARING_HELM_MANIFEST_ACCESS_FORBIDDEN\n' >&2
        exit 77
        ;;
      metadata)
        printf '{"name":"falcone","namespace":"in-falcone-staging","revision":%s,"chart":"%s","appVersion":"0.3.1"}\n' \
          "$release_revision" "$release_chart"
        ;;
      *) exit 2 ;;
    esac
    ;;
  status)
    printf '{"name":"falcone","namespace":"in-falcone-staging","version":%s,"chart":"%s","info":{"status":"%s"}}\n' \
      "$release_revision" "$release_chart" "$release_status"
    ;;
  history)
    case "$scenario" in
      r23-nonnumeric-*)
        r20_status="deployed"
        r20_chart="in-falcone-0.4.1"
        r20_description="Upgrade complete"
        r22_status="failed"
        r22_chart="in-falcone-0.4.8"
        r22_description="$r22_immutable_description"
        r23_status="failed"
        r23_chart="in-falcone-0.4.9"
        r23_description='Upgrade "falcone" failed: context canceled'
        case "$scenario" in
          r23-nonnumeric-r20-status-drift) r20_status="superseded" ;;
          r23-nonnumeric-r20-chart-drift) r20_chart="in-falcone-0.4.2" ;;
          r23-nonnumeric-r20-description-drift) r20_description="Install complete" ;;
          r23-nonnumeric-r22-status-drift) r22_status="pending-upgrade" ;;
          r23-nonnumeric-r22-chart-drift) r22_chart="in-falcone-0.4.7" ;;
          r23-nonnumeric-r22-description-drift) r22_description='Upgrade "falcone" failed: immutable field' ;;
          r23-nonnumeric-r23-status-drift) r23_status="pending-upgrade" ;;
          r23-nonnumeric-r23-chart-drift) r23_chart="in-falcone-0.4.8" ;;
          r23-nonnumeric-r23-description-drift) r23_description='Upgrade "falcone" failed: context canceled by an arbitrary operation' ;;
        esac
        jq -nc \
          --arg r20_status "$r20_status" --arg r20_chart "$r20_chart" --arg r20_description "$r20_description" \
          --arg r21_description "$failed_hook_description" \
          --arg r22_status "$r22_status" --arg r22_chart "$r22_chart" --arg r22_description "$r22_description" \
          --arg r23_status "$r23_status" --arg r23_chart "$r23_chart" --arg r23_description "$r23_description" \
          '[
            {revision:20,status:$r20_status,chart:$r20_chart,description:$r20_description},
            {revision:21,status:"failed",chart:"in-falcone-0.4.7",description:$r21_description},
            {revision:22,status:$r22_status,chart:$r22_chart,description:$r22_description},
            {revision:23,status:$r23_status,chart:$r23_chart,description:$r23_description}
          ]'
        exit 0
        ;;
      r22-immutable-*)
        r22_status="failed"
        r22_chart="in-falcone-0.4.8"
        r22_description="$r22_immutable_description"
        case "$scenario" in
          r22-immutable-status-drift) r22_status="pending-upgrade" ;;
          r22-immutable-chart-drift) r22_chart="in-falcone-0.4.7" ;;
          r22-immutable-description-drift)
            r22_description='Upgrade "falcone" failed: cannot patch "falcone-documentdb-data" with kind PersistentVolumeClaim: spec.storageClassName is immutable'
            ;;
        esac
        jq -nc \
          --arg r22_status "$r22_status" --arg r22_chart "$r22_chart" \
          --arg r22_description "$r22_description" --arg r21_description "$failed_hook_description" \
          '[
            {revision:20,status:"deployed",chart:"in-falcone-0.4.1",description:"Upgrade complete"},
            {revision:21,status:"failed",chart:"in-falcone-0.4.7",description:$r21_description},
            {revision:22,status:$r22_status,chart:$r22_chart,description:$r22_description}
          ]'
        exit 0
        ;;
    esac
    history_revision=21
    history_chart="in-falcone-0.4.7"
    history_status="failed"
    history_description="$failed_hook_description"
    source_status="deployed"
    source_chart="in-falcone-0.4.1"
    case "$scenario" in
      failed-resume-history-revision-drift) history_revision=22 ;;
      failed-resume-history-chart-drift) history_chart="in-falcone-0.4.6" ;;
      failed-resume-history-status-drift) history_status="pending-upgrade" ;;
      failed-resume-history-description-drift) history_description='Upgrade "falcone" failed: another pre-upgrade hook failed' ;;
      failed-resume-history-source-missing)
        jq -nc --arg description "$failed_hook_description" \
          '[{revision:21,status:"failed",chart:"in-falcone-0.4.7",description:$description}]'
        exit 0
        ;;
      failed-resume-history-source-status-drift) source_status="superseded" ;;
      failed-resume-history-source-chart-drift) source_chart="in-falcone-0.4.2" ;;
    esac
    jq -nc \
      --arg source_status "$source_status" --arg source_chart "$source_chart" \
      --argjson history_revision "$history_revision" --arg history_status "$history_status" \
      --arg history_chart "$history_chart" --arg history_description "$history_description" \
      '[
        {revision:20,status:$source_status,chart:$source_chart,description:"Upgrade complete"},
        {revision:$history_revision,status:$history_status,chart:$history_chart,description:$history_description}
      ]'
    ;;
  upgrade)
    require_repair_version "$@"
    upgrade_count=$((upgrade_count + 1))
    printf '%s' "$upgrade_count" >"$helm_state"
    case "$scenario" in
      phase-b-post-delete-helm-failure|forward-helm-failure|phase-a-helm-failure)
        printf 'synthetic repaired-chart apply failure\n' >&2
        exit 42
        ;;
    esac
    exit 0
    ;;
  rollback)
    exit 0
    ;;
  *)
    printf 'unexpected helm fixture invocation: %s\n' "$*" >&2
    exit 2
    ;;
esac
