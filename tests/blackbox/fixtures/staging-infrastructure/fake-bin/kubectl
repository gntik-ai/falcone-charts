        }
      ] else [] end)
      + [
        {
          metadata:{name:"falcone-observability-old",namespace:"in-falcone-staging",labels:{"app.kubernetes.io/instance":"falcone","app.kubernetes.io/name":"observability","pod-template-hash":"old"},ownerReferences:[{apiVersion:"apps/v1",kind:"ReplicaSet",name:"falcone-observability-old",controller:true}]},
          spec:{containers:[{name:"observability",image:"docker.io/prom/prometheus@sha256:6927e0919a144aa7616fd0137d4816816d42f6b816de3af269ab065250859a62"}]},
          status:{phase:"Running",conditions:[{type:"Ready",status:"True"}],containerStatuses:[{name:"observability",image:"docker.io/prom/prometheus@sha256:6927e0919a144aa7616fd0137d4816816d42f6b816de3af269ab065250859a62",ready:true,state:{running:{startedAt:"2026-08-09T00:00:00Z"}}}]}
