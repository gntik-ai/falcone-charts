r23_deployments_json() {
  apisix_available=3
  observability_available=1
  if [ "$scenario" = "r23-nonnumeric-availability-drift" ]; then
    observability_available=0
  fi
  jq -nc --argjson apisix_available "$apisix_available" --argjson observability_available "$observability_available" \
    '{apiVersion:"apps/v1",kind:"DeploymentList",items:[
      {
        metadata:{name:"falcone-apisix",namespace:"in-falcone-staging",generation:23,labels:{"app.kubernetes.io/instance":"falcone","app.kubernetes.io/name":"apisix"}},
        spec:{replicas:3,selector:{matchLabels:{"app.kubernetes.io/instance":"falcone","app.kubernetes.io/name":"apisix"}},template:{metadata:{labels:{"app.kubernetes.io/instance":"falcone","app.kubernetes.io/name":"apisix"}},spec:{containers:[{name:"apisix",image:"docker.io/apache/apisix:3.10.0-debian",securityContext:{runAsNonRoot:true}}]}}},
        status:{observedGeneration:23,replicas:4,updatedReplicas:1,availableReplicas:$apisix_available,unavailableReplicas:1}
      },
      {
        metadata:{name:"falcone-observability",namespace:"in-falcone-staging",generation:23,labels:{"app.kubernetes.io/instance":"falcone","app.kubernetes.io/name":"observability"}},
        spec:{replicas:1,selector:{matchLabels:{"app.kubernetes.io/instance":"falcone","app.kubernetes.io/name":"observability"}},template:{metadata:{labels:{"app.kubernetes.io/instance":"falcone","app.kubernetes.io/name":"observability"}},spec:{containers:[{name:"observability",image:"docker.io/prom/prometheus@sha256:6927e0919a144aa7616fd0137d4816816d42f6b816de3af269ab065250859a62",securityContext:{runAsNonRoot:true}}]}}},
        status:{observedGeneration:23,replicas:2,updatedReplicas:1,availableReplicas:$observability_available,unavailableReplicas:1}
      }
    ]}'
}

case "$scenario" in
  r23-nonnumeric-*)
    case "$args" in
      "-n in-falcone-staging get pods"*"-o json")
        case "$args" in
          *"app.kubernetes.io/name=apisix"*)
            r23_nonnumeric_pods_json | jq '{apiVersion,kind,items:[.items[] | select(.metadata.labels["app.kubernetes.io/name"] == "apisix")]}'
            ;;
          *"app.kubernetes.io/name=observability"*)
            r23_nonnumeric_pods_json | jq '{apiVersion,kind,items:[.items[] | select(.metadata.labels["app.kubernetes.io/name"] == "observability")]}'
            ;;
          *)
            r23_nonnumeric_pods_json
            ;;
        esac
        exit 0
        ;;
      "-n in-falcone-staging get deployments"*"-o json"|\
      "-n in-falcone-staging get deployments.apps"*"-o json")
        r23_deployments_json
        exit 0
        ;;
      "-n in-falcone-staging get deployment falcone-apisix -o json")
        r23_deployments_json | jq '.items[] | select(.metadata.name == "falcone-apisix")'
        exit 0
        ;;
      "-n in-falcone-staging get deployment falcone-observability -o json")
        r23_deployments_json | jq '.items[] | select(.metadata.name == "falcone-observability")'
        exit 0
        ;;
    esac
    ;;
esac

case "$scenario" in
  r22-immutable-*|r23-nonnumeric-*)
    case "$args" in
      "-n in-falcone-staging get pvc falcone-documentdb-data -o json"|\
      "-n in-falcone-staging get pvc falcone-kafka-data -o json"|\
      "-n in-falcone-staging get pvc falcone-observability-data -o json"|\
      "-n in-falcone-staging get pvc falcone-postgresql-data -o json"|\
      "-n in-falcone-staging get pvc data-filer-falcone-seaweedfs-filer-0 -o json"|\
      "-n in-falcone-staging get pvc data-in-falcone-staging-falcone-seaweedfs-master-0 -o json")
        set -- $args
        r22_pvc_json "$5"
        exit 0
        ;;
      "-n in-falcone-staging get pvc -o json")
        printf '{"apiVersion":"v1","kind":"PersistentVolumeClaimList","items":['
        separator=""
        for resource_name in \
          falcone-documentdb-data falcone-kafka-data falcone-observability-data falcone-postgresql-data \
          data-filer-falcone-seaweedfs-filer-0 data-in-falcone-staging-falcone-seaweedfs-master-0; do
          printf '%s' "$separator"
          r22_pvc_json "$resource_name" | tr -d '\n'
          separator=,
        done
        printf ']}\n'
        exit 0
        ;;
      "-n in-falcone-staging get statefulset falcone-seaweedfs-filer -o json"|\
      "-n in-falcone-staging get statefulsets.apps falcone-seaweedfs-filer -o json")
        r22_statefulset_json falcone-seaweedfs-filer
        exit 0
        ;;
      "-n in-falcone-staging get statefulset falcone-seaweedfs-master -o json"|\
      "-n in-falcone-staging get statefulsets.apps falcone-seaweedfs-master -o json")
        r22_statefulset_json falcone-seaweedfs-master
        exit 0
        ;;
      "-n in-falcone-staging get statefulset -o json"|\
      "-n in-falcone-staging get statefulsets.apps -o json")
        printf '{"apiVersion":"apps/v1","kind":"StatefulSetList","items":['
        r22_statefulset_json falcone-seaweedfs-filer | tr -d '\n'
        printf ','
        r22_statefulset_json falcone-seaweedfs-master | tr -d '\n'
        printf ']}\n'
        exit 0
        ;;
    esac
    ;;
esac

case "$args" in
  "get namespace in-falcone-staging")
    exit 0
    ;;
  "-n in-falcone-staging get pvc falcone-postgresql-vector-data -o json")
    count=0
    [ ! -f "$state_file" ] || count="$(cat "$state_file")"
    count=$((count + 1))
    printf '%s' "$count" >"$state_file"
    uid="bbx-pvc-uid"
    phase="Pending"
    volume=""
    if [ "$count" -ge 2 ]; then
      case "$scenario" in
        pvc-uid-changed) uid="bbx-pvc-replaced" ;;
        pvc-phase-changed) phase="Bound" ;;
        pvc-volume-changed) volume="bbx-pv-late" ;;
      esac
    elif [ "$scenario" = "pvc-already-bound" ]; then
      phase="Bound"
    fi
    printf '{"metadata":{"uid":"%s"},"spec":{"volumeName":"%s"},"status":{"phase":"%s"}}\n' \
      "$uid" "$volume" "$phase"
    exit 0
    ;;
  "get pv -o json")
    count=0
    [ ! -f "$state_file" ] || count="$(cat "$state_file")"
    if [ "$scenario" = "pv-claimref-added" ] && [ "$count" -ge 2 ]; then
      printf '{"items":[{"spec":{"claimRef":{"uid":"bbx-pvc-uid","namespace":"in-falcone-staging","name":"falcone-postgresql-vector-data"}}}]}\n'
    else
      printf '{"items":[]}\n'
    fi
    exit 0
    ;;
esac

case "$args" in
  "-n in-falcone-staging get pods"*"-o json")
    count=0
    [ ! -f "$state_file" ] || count="$(cat "$state_file")"
    if [ "$scenario" = "initial-pending-vector-pod" ] && [ ! -f "$scale_state" ]; then
      printf '{"items":[{"metadata":{"name":"falcone-postgresql-vector-0","namespace":"in-falcone-staging","ownerReferences":[{"apiVersion":"apps/v1","kind":"StatefulSet","name":"falcone-postgresql-vector","controller":true}]},"spec":{"volumes":[{"persistentVolumeClaim":{"claimName":"falcone-postgresql-vector-data"}}]},"status":{"phase":"Pending"}}]}\n'
    elif [ "$scenario" = "pod-evidence-added" ] && [ "$count" -ge 2 ]; then
      printf '{"items":[{"metadata":{"name":"bbx-vector-pod"},"spec":{"volumes":[{"persistentVolumeClaim":{"claimName":"falcone-postgresql-vector-data"}}]},"status":{"phase":"Running"}}]}\n'
    else
      printf '{"items":[]}\n'
    fi
    exit 0
    ;;
  "-n in-falcone-staging get pvc falcone-postgresql-vector-data")
    # Forward recovery checks only whether the exact PVC exists.
    exit 0
    ;;
  "-n in-falcone-staging get externalsecrets.external-secrets.io -o json")
    [ -n "$external_secrets_fixture" ] || { printf 'external secret fixture missing\n' >&2; exit 2; }
    case "$scenario" in
      external-secrets-zero) printf '{"apiVersion":"v1","kind":"ExternalSecretList","items":[]}\n' ;;
      external-secrets-partial) jq '.items = .items[0:13]' "$external_secrets_fixture" ;;
      external-secrets-duplicate) jq '.items = (.items[0:13] + [.items[0]])' "$external_secrets_fixture" ;;
      external-secrets-notready) jq '.items[0].status.conditions[0] = {"type":"Ready","status":"False","reason":"ProviderError"}' "$external_secrets_fixture" ;;
      post-no-root-health-regression)
        upgrades=0; [ ! -f "$helm_state" ] || upgrades="$(cat "$helm_state")"
        if [ "$upgrades" -ge 2 ]; then
          jq '.items[0].status.conditions[0] = {"type":"Ready","status":"False","reason":"ProviderError"}' "$external_secrets_fixture"
        else
          cat "$external_secrets_fixture"
        fi
        ;;
      *) cat "$external_secrets_fixture" ;;
    esac
    exit 0
    ;;
  "-n in-falcone-staging get deployment falcone-control-plane -o json")
    signing_mode="legacy"
    signing_managed="false"
    signing_name="falcone-webhook-signing-key-c25-legacy"
    signing_key="key"
    signing_id="wk1:5fc9546bfa1d386a4d27fd80823bb1fe679ddf9856ba96cc5fddab79189b50cd"
    case "$scenario" in
      custody-deployment-missing)
        printf '{"metadata":{"name":"falcone-control-plane","namespace":"in-falcone-staging"},"spec":{"template":{"metadata":{"annotations":{}},"spec":{"containers":[{"name":"control-plane","env":[]}]}}}}\n'
        exit 0
        ;;
      custody-deployment-mode-drift) signing_mode="canonical-v1" ;;
      custody-deployment-managed-drift) signing_managed="true" ;;
      custody-deployment-reference-drift) signing_name="another-reference" ;;
      custody-deployment-id-drift) signing_id="canonical-v1:unexpected" ;;
    esac
    printf '{"metadata":{"name":"falcone-control-plane","namespace":"in-falcone-staging"},"spec":{"template":{"metadata":{"annotations":{"in-falcone.io/webhook-key-mode":"%s","in-falcone.io/webhook-key-request-id":"c25-staging-adopt-20260723-01","in-falcone.io/webhook-key-action":"none","in-falcone.io/webhook-key-id":"%s"}},"spec":{"containers":[{"name":"control-plane","env":[{"name":"WEBHOOK_SIGNING_KEY","valueFrom":{"secretKeyRef":{"name":"%s","key":"%s","optional":false}}},{"name":"WEBHOOK_SIGNING_KEY_MODE","value":"%s"},{"name":"WEBHOOK_SIGNING_KEY_MANAGED","value":"%s"}]}]}}}}\n' \
      "$signing_mode" "$signing_id" "$signing_name" "$signing_key" "$signing_mode" "$signing_managed"
    exit 0
    ;;
  "-n secret-store logs job/openbao-auth-reconcile")
    upgrades=0; [ ! -f "$helm_state" ] || upgrades="$(cat "$helm_state")"
    if [ "$scenario" = "post-no-root-health-regression" ] && [ "$upgrades" -ge 2 ]; then
      printf 'result=changed code=AUTH_METADATA_CONVERGED canary=passed\n'
    else
      printf 'result=unchanged code=AUTH_METADATA_MATCHED canary=passed\n'
    fi
    exit 0
    ;;
  "-n in-falcone-staging get deployment falcone-ferretdb -o json")
    printf '{"spec":{"replicas":2},"status":{"availableReplicas":2,"updatedReplicas":2,"unavailableReplicas":0}}\n'
    exit 0
    ;;
  "-n in-falcone-staging get endpointslices.discovery.k8s.io -l kubernetes.io/service-name=falcone-ferretdb -o json")
    printf '{"items":[{"endpoints":[{"conditions":{"ready":true}},{"conditions":{"ready":true}}]}]}\n'
    exit 0
    ;;
  "-n external-secrets get deployment external-secrets -o json")
    upgrades=0; [ ! -f "$helm_state" ] || upgrades="$(cat "$helm_state")"
    owner="external-secrets"; owner_ns="external-secrets"
    if [ "$scenario" = "external-owner-changed-after-apply" ] && [ "$upgrades" -ge 1 ]; then owner="falcone"; owner_ns="in-falcone-staging"; fi
    printf '{"metadata":{"name":"external-secrets","namespace":"external-secrets","annotations":{"meta.helm.sh/release-name":"%s","meta.helm.sh/release-namespace":"%s"},"labels":{"app.kubernetes.io/managed-by":"Helm"}},"status":{"availableReplicas":1}}\n' "$owner" "$owner_ns"
    exit 0
    ;;
  "-n external-secrets get "*" -o json")
    set -- $args
    resource_name="$5"
    printf '{"metadata":{"name":"%s","namespace":"external-secrets","annotations":{"meta.helm.sh/release-name":"external-secrets","meta.helm.sh/release-namespace":"external-secrets"},"labels":{"app.kubernetes.io/managed-by":"Helm"}}}\n' \
      "$resource_name"
    exit 0
    ;;
  get\ clusterrole*\ -o\ json|\
  get\ validatingwebhookconfiguration*\ -o\ json)
    set -- $args
    resource_name="$3"
    printf '{"metadata":{"name":"%s","annotations":{"meta.helm.sh/release-name":"external-secrets","meta.helm.sh/release-namespace":"external-secrets"},"labels":{"app.kubernetes.io/managed-by":"Helm"}}}\n' \
      "$resource_name"
    exit 0
    ;;
  "-n in-falcone-staging scale statefulset falcone-postgresql-vector --replicas=0")
    printf '%s' scaled >"$scale_state"
    exit 0
    ;;
  "-n in-falcone-staging delete pvc falcone-postgresql-vector-data --wait=true"|\
  "-n in-falcone-staging wait "*|\
  "wait "*|\
  "-n in-falcone-staging rollout status "*)
    exit 0
    ;;
esac

if [ "$args" = "create --dry-run=client -f - -o json" ]; then
  python3 -c 'import json,sys,yaml; json.dump(yaml.safe_load(sys.stdin.read()),sys.stdout)'
  printf '\n'
  exit 0
fi

printf 'unexpected kubectl fixture invocation: %s\n' "$args" >&2
exit 2
