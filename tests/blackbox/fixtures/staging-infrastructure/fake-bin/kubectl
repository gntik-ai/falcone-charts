#!/usr/bin/env sh
set -eu

printf '%s\n' "$*" >>"${FALCONE_STAGING_KUBECTL_LOG:?}"
[ -z "${FALCONE_STAGING_OPERATION_LOG:-}" ] || printf 'kubectl %s\n' "$*" >>"$FALCONE_STAGING_OPERATION_LOG"
scenario="${FALCONE_STAGING_SCENARIO:-safe}"
state_file="${FALCONE_STAGING_STATE_FILE:?}"
helm_state="${FALCONE_STAGING_HELM_STATE_FILE:-${state_file}.helm}"
scale_state="${FALCONE_STAGING_SCALE_STATE_FILE:-${state_file}.scaled}"
external_secrets_fixture="${FALCONE_STAGING_EXTERNAL_SECRETS_FIXTURE:-}"
args="$*"

case " $args " in
  *" get secret "*|*" get secrets "*)
    printf 'SECRET_DATA_READ_FORBIDDEN\n' >&2
    exit 77
    ;;
esac

if [ "$args" = "config current-context" ]; then
  if [ "$scenario" = "wrong-context" ]; then
    printf 'production\n'
  else
    printf 'default\n'
  fi
  exit 0
fi

r22_pvc_json() {
  resource_name="$1"
  storage_class="local-path"
  storage_size="10Gi"
  case "$scenario:$resource_name" in
    r22-immutable-pvc-storage-drift:falcone-documentdb-data)
      storage_class="hcloud-volumes"
      ;;
    r22-immutable-pvc-size-drift:falcone-kafka-data)
      storage_size="20Gi"
      ;;
    r22-immutable-child-pvc-drift:data-in-falcone-staging-falcone-seaweedfs-master-0)
      storage_class="hcloud-volumes"
      ;;
  esac
  printf '{"apiVersion":"v1","kind":"PersistentVolumeClaim","metadata":{"name":"%s","namespace":"in-falcone-staging","uid":"bbx-%s-uid"},"spec":{"accessModes":["ReadWriteOnce"],"storageClassName":"%s","resources":{"requests":{"storage":"%s"}},"volumeName":"bbx-%s-pv"},"status":{"phase":"Bound"}}\n' \
    "$resource_name" "$resource_name" "$storage_class" "$storage_size" "$resource_name"
}

r22_statefulset_json() {
  resource_name="$1"
  case "$resource_name" in
    falcone-seaweedfs-filer)
      component="filer"
      claim_name="data-filer"
      ;;
    falcone-seaweedfs-master)
      component="master"
      claim_name="data-in-falcone-staging"
      ;;
    *)
      printf 'unexpected r22 StatefulSet fixture resource: %s\n' "$resource_name" >&2
      exit 2
      ;;
  esac
  storage_size="10Gi"
  if [ "$scenario" = "r22-immutable-vct-drift" ] && [ "$resource_name" = "falcone-seaweedfs-filer" ]; then
    storage_size="11Gi"
  fi
  jq -nc \
    --arg name "$resource_name" --arg component "$component" --arg claim "$claim_name" --arg storage "$storage_size" \
    '{
      apiVersion:"apps/v1", kind:"StatefulSet",
      metadata:{name:$name,namespace:"in-falcone-staging",uid:("bbx-" + $component + "-statefulset-uid")},
      spec:{
        serviceName:$name, podManagementPolicy:"Parallel", replicas:1,
        selector:{matchLabels:{"app.kubernetes.io/name":"seaweedfs","app.kubernetes.io/instance":"falcone","app.kubernetes.io/component":$component}},
        template:{metadata:{labels:{"app.kubernetes.io/name":"seaweedfs","app.kubernetes.io/instance":"falcone","app.kubernetes.io/component":$component}},spec:{containers:[{name:"seaweedfs",image:"example.invalid/seaweedfs@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}]}},
        volumeClaimTemplates:[{apiVersion:"v1",kind:"PersistentVolumeClaim",metadata:{name:$claim},spec:{accessModes:["ReadWriteOnce"],storageClassName:"hcloud-volumes",resources:{requests:{storage:$storage}}}}]
      }
    }'
}

