    mode: 'managed',
    owner: runtimeOwner || undefined,
    compatibility: 'unverified',
    readiness: {
      state: 'unavailable', stage: 'configured', reason: 'AWAITING_INITIAL_PROJECTION',
      lastTransitionAt: '1970-01-01T00:00:00Z',
    },
    observedAt: '1970-01-01T00:00:00Z',
    validUntil: '1970-01-01T00:00:00Z',
  }
  return object('ConfigMap', 'falcone-knative-runtime', {
    metadata: { namespace: 'falcone-bbx', resourceVersion: '89', labels },
    data: { 'status.json': JSON.stringify(document) },
  })
