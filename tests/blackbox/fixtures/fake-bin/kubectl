const installedOwnerScenarios = new Set([
  'installed-managed',
  'handoff-target-fail',
  'acceptance-outage',
  'acceptance-restart',
  'acceptance-recover',
  'acceptance-replacement-conflict',
  'rollback-supported-stored-incompatible',
  'upgrade-patch-downgrade',
  'replacement-conflict-same-name-swap',
])

function previousKubectlCalls() {
  const path = process.env.FALCONE_BBX_KUBECTL_LOG
  if (!path) return []
  try {
    const calls = readFileSync(path, 'utf8').trim().split('\n').filter(Boolean).map((line) => JSON.parse(line))
    return calls.slice(0, -1)
  } catch {
    return []
  }
}

function statusNamespaceWasCreated() {
  return previousKubectlCalls().some((call) => {
    const command = (call.args ?? []).join(' ')
    const input = `${call.stdin ?? ''}\n${call.fileInput ?? ''}`
    return /\b(?:create|apply)\s+(?:namespace|ns)(?:\/|\s+)knative-serving\b/i.test(command)
      || (/\bkind:\s*Namespace\b/.test(input) && /\bname:\s*knative-serving\b/.test(input))
      || (/"kind"\s*:\s*"Namespace"/.test(input) && /"name"\s*:\s*"knative-serving"/.test(input))
  })
}

function priorRegistrationMutation(pattern) {
  return previousKubectlCalls().some((call) => pattern.test(`${(call.args ?? []).join(' ')}\n${call.stdin ?? ''}\n${call.fileInput ?? ''}`))
}

function priorSubmittedObject(pattern) {
  return previousKubectlCalls().some((call) => pattern.test(`${call.stdin ?? ''}\n${call.fileInput ?? ''}`))
}

function reverseHandoffTargetWasEnabled() {
  return priorSubmittedObject(/falcone-knative-handoff-target[\s\S]*(?:"owner"\s*:\s*"falcone"|falcone\.io\/target-owner["':=\s]+falcone)/i)
}

function purgeFenceState() {
  const calls = previousKubectlCalls()
  const submitted = (call) => `${call.stdin ?? ''}\n${call.fileInput ?? ''}`
  const policyIndex = calls.findIndex((call) => /kind["':\s]+ValidatingAdmissionPolicy\b/i.test(submitted(call)))
  const bindingIndex = calls.findIndex((call) => /kind["':\s]+ValidatingAdmissionPolicyBinding\b/i.test(submitted(call)))
  const installedAt = policyIndex >= 0 && bindingIndex >= 0 ? Math.max(policyIndex, bindingIndex) : -1
  const reinventoryComplete = installedAt >= 0 && bundleCrdNames.every((name) => calls.some((call, index) => (
    index > installedAt
    && (call.args ?? []).includes('get')
    && (call.args ?? []).some((arg) => arg === name)
  )))
  return { installedAt, reinventoryComplete }
}

if (verb === 'version') {
  const minor = scenario === 'unsupported-kubernetes' ? '33' : '34'
  output({ clientVersion: { gitVersion: 'v1.34.0' }, serverVersion: { gitVersion: `v1.${minor}.0`, major: '1', minor } })
  process.exit(0)
}

if (verb === 'auth') {
  if (scenario === 'namespace-only' && tail.includes('can-i')) output('no\n')
  else output('yes\n')
  process.exit(0)
}

if (verb === 'api-resources') {
  output('namespaces\ncustomresourcedefinitions.apiextensions.k8s.io\nclusterroles.rbac.authorization.k8s.io\nvalidatingwebhookconfigurations.admissionregistration.k8s.io\n')
  process.exit(0)
}

if (verb === 'get') {
  const target = tail.join(' ')
  if (target.includes('--raw')) {
    output('ok\n')
    process.exit(0)
  }
  if (/clusterversion/.test(target)) {
    const version = scenario === 'unsupported-openshift' ? '4.20.0' : '4.21.0'
    output({ apiVersion: 'config.openshift.io/v1', kind: 'ClusterVersion', metadata: { name: 'version' }, status: { desired: { version }, history: [{ state: 'Completed', version }] } })
    process.exit(0)
  }
  if (/infrastructures?|infrastructure /.test(target)) {
    output({ apiVersion: 'config.openshift.io/v1', kind: 'Infrastructure', metadata: { name: 'cluster' }, status: { infrastructureName: 'bbx-ocp421', infrastructureId: 'bbx-ocp421-x8', apiServerURL: 'https://api.bbx.example.test:6443' } })
    process.exit(0)
  }
  if (/namespace.*kube-system|namespace\/kube-system|ns kube-system/.test(target)) {
    output(object('Namespace', 'kube-system', { metadata: { uid: '00000000-0000-4000-8000-000000000008' } }))
    process.exit(0)
  }
  if (scenario === 'clean-status-namespace-absent' && /(?:namespace|namespaces|ns)(?:\/|\s+)knative-serving\b/.test(target)) {
    if (!statusNamespaceWasCreated()) fail('NotFound: namespace knative-serving does not exist')
    output(object('Namespace', 'knative-serving', { metadata: { labels: { 'falcone.io/knative-owner': owner } } }))
    process.exit(0)
  }
  if (/\b(?:namespace|namespaces|ns)(?:\/|\s+)falcone-bbx\b/.test(target) && scenario.startsWith('registration-')) {
    const namespaceOwner = scenario === 'registration-foreign-owner' ? 'foreign-owner' : owner
    const postInstallScenario = scenario.startsWith('registration-runtime-')
    const registration = postInstallScenario
      ? (priorRegistrationMutation(/\blabel\s+namespace\s+falcone-bbx[\s\S]*falcone\.io\/knative-runtime-projection=enabled/i) ? 'enabled' : '')
      : 'enabled'
    if (/jsonpath|go-template/.test(target)) {
      const asksRegistration = /knative-runtime-projection/.test(target)
      const asksOwner = /knative-owner/.test(target)
      const asksResourceVersion = /resourceVersion/.test(target)
      if (asksRegistration && asksOwner && asksResourceVersion) output(`${registration}\t${namespaceOwner}\t77`)
      else if (asksRegistration && asksOwner) output(`${registration}\t${namespaceOwner}`)
      else if (asksResourceVersion) output('77')
      else if (asksRegistration) output(registration)
      else if (asksOwner) output(namespaceOwner)
      else output('falcone-bbx')
    } else {
      output(object('Namespace', 'falcone-bbx', { metadata: { resourceVersion: '77', labels: {
        'falcone.io/knative-runtime-projection': registration,
        'falcone.io/knative-owner': namespaceOwner,
      } } }))
    }
    process.exit(0)
  }
  const registeredNamespaceName = /\b(?:namespace|namespaces|ns)(?:\/|\s+)(falcone-app-[ab])\b/.exec(target)?.[1]
  if (registeredNamespaceName) {
    const resourceVersion = registeredNamespaceName === 'falcone-app-a' ? '81' : '82'
    output(object('Namespace', registeredNamespaceName, { metadata: {
      resourceVersion,
      labels: { 'falcone.io/knative-runtime-projection': 'enabled', 'falcone.io/knative-owner': owner },
    } }))
    process.exit(0)
  }
  if (/namespaces?|\bns\b/.test(target)) {
    const inventoryCollision = scenario === 'inventory-known-bundle-namespace'
      ? [object('Namespace', 'knative-serving', { metadata: { labels: { 'falcone.io/knative-owner': 'foreign-lifecycle-owner' } } })]
      : []
    output({
      apiVersion: 'v1',
      kind: 'NamespaceList',
      items: [
        object('Namespace', 'falcone-app-a', { metadata: { resourceVersion: '81', labels: { 'falcone.io/knative-runtime-projection': 'enabled', 'falcone.io/knative-owner': owner } } }),
        object('Namespace', 'falcone-app-b', { metadata: { resourceVersion: '82', labels: { 'falcone.io/knative-runtime-projection': 'enabled', 'falcone.io/knative-owner': owner } } }),
        object('Namespace', 'falcone-unregistered', { metadata: { resourceVersion: '83' } }),
        object('Namespace', 'falcone-foreign', { metadata: { resourceVersion: '84', labels: { 'falcone.io/knative-runtime-projection': 'enabled', 'falcone.io/knative-owner': 'foreign-owner' } } }),
        ...inventoryCollision,
      ],
    })
    process.exit(0)
  }
  const inventoryCollision = inventoryCollisionFor(scenario)
  if (inventoryCollision && targetCanReturnCollision(target, inventoryCollision)) {
    output({ apiVersion: 'v1', kind: 'List', items: [inventoryCollision] })
    process.exit(0)
  }
  if (scenario === 'replacement-conflict-same-name-swap' && /(?:ksvc|services\.serving\.knative\.dev)(?:\/|\s+)bbx-service\b/.test(target)) {
    output(replacementService())
    process.exit(0)
  }
  if (scenario.startsWith('purge-') && /(?:ksvc|services\.serving\.knative\.dev)/.test(target)) {
    const foreign = object('Service', 'foreign-service', {
      metadata: {
        namespace: 'foreign-app',
        labels: scenario === 'purge-unowned-cr' ? {} : { 'falcone.io/knative-owner': 'foreign-owner' },
      },
    })
    const safeOwnedOnly = ['purge-unverified-backup', 'purge-exact-owned-bundle', 'purge-extra-owner-crd', 'purge-race-fence'].includes(scenario)
    const unownedBundleResource = scenario === 'purge-unowned-bundle-cr'
      ? object('Service', 'unowned-service', { metadata: { namespace: 'falcone-app-a' } })
      : null
    output({
      apiVersion: 'v1',
      kind: 'List',
      items: safeOwnedOnly
        ? [ownedPurgeService()]
        : unownedBundleResource
          ? [object('Service', 'owned-service', { metadata: { namespace: 'falcone-app-a', labels: { 'falcone.io/knative-owner': owner } } }), unownedBundleResource]
          : [object('Service', 'owned-service', { metadata: { namespace: 'falcone-app-a', labels: { 'falcone.io/knative-owner': owner } } }), foreign],
    })
    process.exit(0)
  }
  if (/ksvc|services\.serving\.knative\.dev/.test(target)) {
    if (scenario === 'external-canary-missing') fail('NotFound: external canary is absent')
    output({
      apiVersion: 'serving.knative.dev/v1',
      kind: 'Service',
      metadata: { name: 'external-canary', namespace: 'knative-serving' },
      status: {
        url: 'http://external-canary.knative-serving.svc.cluster.local',
        conditions: [{ type: 'Ready', status: scenario === 'external-canary-unhealthy' ? 'False' : 'True' }],
      },
    })
    process.exit(0)
  }
  if (/endpoints?|endpoint.?slices?/.test(target)) {
    if (scenario === 'stage-webhook-fail') fail('webhook endpoint is not ready')
    const addresses = scenario === 'stage-webhook-endpoints-empty' ? [] : [{ ip: '10.0.0.8' }]
    output({ apiVersion: 'v1', kind: 'Endpoints', metadata: { name: 'webhook', namespace: 'knative-serving' }, subsets: [{ addresses, ports: [{ name: 'https-webhook', port: 8443 }] }] })
