function inventoryCollisionFor(activeScenario) {
  const collisions = {
    'inventory-foreign-config-network': {
      apiVersion: 'v1', kind: 'ConfigMap', metadata: { name: 'config-network', namespace: 'knative-serving', labels: { 'falcone.io/knative-owner': 'foreign-owner' } },
    },
    'inventory-unowned-webhook-certs': {
      apiVersion: 'v1', kind: 'Secret', metadata: { name: 'webhook-certs', namespace: 'knative-serving' }, type: 'kubernetes.io/tls',
    },
    'inventory-foreign-controller-serviceaccount': {
      apiVersion: 'v1', kind: 'ServiceAccount', metadata: { name: 'controller', namespace: 'knative-serving', labels: { 'falcone.io/knative-owner': 'foreign-owner' } },
    },
    'inventory-unowned-activator-role': {
      apiVersion: 'rbac.authorization.k8s.io/v1', kind: 'Role', metadata: { name: 'knative-serving-activator', namespace: 'knative-serving' }, rules: [],
    },
    'inventory-foreign-activator-rolebinding': {
      apiVersion: 'rbac.authorization.k8s.io/v1', kind: 'RoleBinding', metadata: { name: 'knative-serving-activator', namespace: 'knative-serving', labels: { 'falcone.io/knative-owner': 'foreign-owner' } }, subjects: [],
    },
    'inventory-unowned-webhook-hpa': {
      apiVersion: 'autoscaling/v2', kind: 'HorizontalPodAutoscaler', metadata: { name: 'webhook', namespace: 'knative-serving' },
    },
    'inventory-foreign-webhook-pdb': {
      apiVersion: 'policy/v1', kind: 'PodDisruptionBudget', metadata: { name: 'webhook-pdb', namespace: 'knative-serving', labels: { 'falcone.io/knative-owner': 'foreign-owner' } },
    },
    'inventory-unowned-routing-certificate': {
      apiVersion: 'networking.internal.knative.dev/v1alpha1', kind: 'Certificate', metadata: { name: 'routing-serving-certs', namespace: 'knative-serving' },
    },
  }
  return collisions[activeScenario]
}

function targetCanReturnCollision(target, collision) {
  const kindPatterns = {
    ConfigMap: /(?:^|[,\s])(?:configmaps?|cm)(?:[.,\s]|$)/i,
    Secret: /(?:^|[,\s])secrets?(?:[.,\s]|$)/i,
    ServiceAccount: /(?:^|[,\s])serviceaccounts?(?:[.,\s]|$)/i,
    Role: /(?:^|[,\s])roles?(?:\.rbac\.authorization\.k8s\.io)?(?:[,\s]|$)/i,
    RoleBinding: /(?:^|[,\s])rolebindings?(?:\.rbac\.authorization\.k8s\.io)?(?:[,\s]|$)/i,
    HorizontalPodAutoscaler: /(?:^|[,\s])(?:horizontalpodautoscalers?|hpa)(?:[.,\s]|$)/i,
    PodDisruptionBudget: /(?:^|[,\s])(?:poddisruptionbudgets?|pdb)(?:[.,\s]|$)/i,
    Certificate: /(?:^|[,\s])certificates?(?:\.networking\.internal\.knative\.dev)?(?:[,\s]|$)/i,
  }
  return kindPatterns[collision?.kind]?.test(target) ?? false
}

